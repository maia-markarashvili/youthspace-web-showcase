# ── მონაცემთა ბაზა (Neon / Postgres) ──────────────────────────────
# Neon-ის pooled connection string (…-pooler.…neon.tech)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ── საიტი ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="995555113111"

# ── Admin (seed-ის root მომხმარებელი) ─────────────────────────────
ADMIN_SEED_EMAIL="admin@youthspace.ge"
ADMIN_SEED_PASSWORD="change-me-before-production"
# openssl rand -base64 32   (ფაზა 2 — admin სესია)
SESSION_SECRET=""

# ── Flitt — ბარათით გადახდა ───────────────────────────────────────
# ცარიელი = ბარათის ღილაკი არსად ჩანს (გადმორიცხვა ისევ მუშაობს).
# სატესტო merchant (გადამოწმებულია, GEL-ს უჭერს მხარს): 1549901 / "test".
# ⚠ Fondy-ს ძველი დემო 1396424 Flitt-ზე **არ მუშაობს** ("Merchant not found").
FLITT_MERCHANT_ID=""
FLITT_SECRET_KEY=""
# "live" = ბარათი ყველას ჩანს; ცარიელი/სხვა = მხოლოდ ?pay=card-ით (ტესტირება
# ცოცხალ დომენზე ისე, რომ ჩვეულებრივმა სტუმარმა ვერაფერი დაინახოს)
FLITT_MODE=""
# "1" = callback მხოლოდ Flitt-ის IP-ებიდან მიიღება (54.154.216.60, 3.75.125.89, 45.154.88.64)
FLITT_ENFORCE_IP=""

# ── n8n ავტომატიზაცია (ფაზა 4) ────────────────────────────────────
# ცარიელი მნიშვნელობისას notify() no-op-ია (dev log)
N8N_WEBHOOK_URL=""
N8N_SECRET=""

# ── SMS (ubill.dev) ───────────────────────────────────────────────
# ორივეს ცარიელობისას SMS არ იგზავნება (dev log) — საიტი ნორმალურად მუშაობს.
# გასაღები: my.ubill.ge → API; brandID: იქვე, გამგზავნის სახელის (brand) ID.
# შეტყობინებების ტექსტები /admin/texts → SMS ტაბშია (ცარიელი = არ იგზავნება).
UBILL_API_KEY=""
UBILL_BRAND_ID=""

# ── Google-ით შესვლა (OAuth) ──────────────────────────────────────
# ორივეს ცარიელობისას „Google-ით შესვლა" ღილაკი არ ჩნდება, მეილი/პაროლით
# შესვლა კი ჩვეულებრივ მუშაობს. console.cloud.google.com → APIs & Services
# → Credentials → OAuth client ID (Web application).
# ⚠ Authorized redirect URI ზუსტად ასე უნდა ეწეროს (თითო დომენზე):
#    <საიტის მისამართი>/login/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── ელფოსტა (hostedemail.com / Tucows — არა cPanel) ────────────────
# HOST/USER/PASS-ის ცარიელობისას მეილი არ იგზავნება (dev log) — SMS-ის
# იგივე პრინციპი. შეტყობინებების ტექსტები /admin/texts → ელფოსტა ტაბშია
# (სათაური ან ტექსტის ცარიელობა = ეს წერილი არ იგზავნება).
#
# ⚠ ორი ხაფანგი, რომელშიც უკვე გავებით:
# 1. youthspace.ge-ის ფოსტა **ჰოსტინგზე (cPanel) არ არის** — MX მიდის
#    mx.youthspace.ge.cust.hostedemail.com-ზე. ყუთის პაროლი cPanel-ში
#    არ იმართება; webmail: mail.youthspace.ge
# 2. HOST უნდა იყოს **smtp.hostedemail.com**, და არა mail.youthspace.ge —
#    ორივე ერთ სერვერზე მიდის, მაგრამ სერტიფიკატი *.hostedemail.com-ზეა,
#    ამიტომ mail.youthspace.ge-ით მკაცრი TLS წყდება:
#    "Hostname/IP does not match certificate's altnames".
SMTP_HOST=""
SMTP_PORT="587"
# "1"/"true" = TLS თავიდანვე (465-ზე); სხვაგვარად STARTTLS (587-ზე)
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# ცარიელი = "სივრცე" <info@youthspace.ge>
MAIL_FROM=""
MAIL_REPLY_TO=""

# ── ატვირთვები ────────────────────────────────────────────────────
# Railway-ზე მუდმივი volume-ის mount path (მაგ. /data/uploads).
# ცარიელი = <cwd>/.uploads (ლოკალური dev)
UPLOAD_DIR=""

# ── ანალიტიკა (ფაზა 4 — cookie consent-ის მიღმა) ──────────────────
NEXT_PUBLIC_GA_ID=""
# ცარიელი = კოდის fallback-ID მოქმედებს (meta-pixel.tsx); build-დროს ილუქება
NEXT_PUBLIC_META_PIXEL_ID=""
